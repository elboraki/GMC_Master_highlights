# Slack App Credentials
# Get from https://api.slack.com/apps -> Your App -> Basic Information
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Bot Token — requires scopes: chat:write, channels:history
# Get from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token (required for Socket Mode)
# Get from Basic Information -> App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token

# Port (default 3000)
PORT=3000
